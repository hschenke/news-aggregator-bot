# Streamlit Community Cloud Secrets
# In der Streamlit Cloud gehst du in deiner App auf:
# Settings -> Secrets und fügst diese Zeilen ein:

GEMINI_API_KEY = "dein_google_gemini_api_key_hier"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional: Passwortschutz gegen unbefugte Nutzung (PIN oder Passwort)
# Wenn gesetzt, wird beim Öffnen der Web-App nach diesem Passwort gefragt.
APP_PASSWORD = "dein_geheimes_passwort_hier"

# Optional: Automatischer GitHub-Sync für das Feed-Dashboard
# Spiegelt jede Dashboard-Änderung sofort als Commit in GitHub zurück.
GITHUB_TOKEN = "ghp_dein_personal_access_token_hier"
GITHUB_REPO = "hschenke/news-aggregator-bot"
GITHUB_BRANCH = "main"
