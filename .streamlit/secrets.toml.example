# Streamlit Community Cloud Secrets
# In der Streamlit Cloud gehst du in deiner App auf:
# Settings -> Secrets und fügst diese Zeilen ein:

GEMINI_API_KEY = "dein_google_gemini_api_key_hier"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional: Passwortschutz gegen unbefugte Nutzung (PIN oder Passwort)
# Wenn gesetzt, wird beim Öffnen der Web-App nach diesem Passwort gefragt.
APP_PASSWORD = "dein_geheimes_passwort_hier"

# Optional: Cloud-Datenbank (Turso LibSQL / Cloud SQLite)
TURSO_URL = "libsql://deine-db-name.turso.io"
TURSO_KEY = "ey..."

# Optional: Automatischer GitHub-Sync & Actions-Trigger aus dem Dashboard
# Fine-Grained Personal Access Token (github_pat_...)
# Benötigte Berechtigungen:
# - Repository access: hschenke/news-bot
# - Permissions: Contents (Read and write) & Actions (Read and write)
GITHUB_TOKEN = "github_pat_dein_fine_grained_token_hier"
GITHUB_REPO = "hschenke/news-bot"
GITHUB_BRANCH = "main"
