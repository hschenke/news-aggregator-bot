# ===============================================
# News Aggregator Bot Configuration
# ===============================================

# LLM API Key (Kostenlos via Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# E-Mail Versand (z. B. kostenlos via Resend: https://resend.com oder SMTP)
# Optionen: "resend" oder "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Fallback (optional, falls kein Resend verwendet wird)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Empfänger und Absender
EMAIL_FROM="News Bot <onboarding@resend.dev>"
EMAIL_TO=deine_email@example.com
