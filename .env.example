# Gemini API Key (von https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# E-Mail Distribution (Weg A - Resend oder SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_TO=deine_email@beispiel.de
EMAIL_FROM="News Bot <onboarding@resend.dev>"

# Optionaler Web-App Schutz (Weg B - Streamlit)
APP_PASSWORD=
STREAMLIT_APP_URL=https://news-aggregator-bot-sdfgedfwcu7yr9gzikr8q8.streamlit.app

# Optional: Automatischer GitHub-Sync für Quellen-Änderungen im Dashboard
GITHUB_TOKEN=
GITHUB_REPO=hschenke/news-aggregator-bot
GITHUB_BRANCH=main
