# Gemini API Key (von https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# E-Mail Distribution (Weg A - Resend oder SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_TO=deine_email@beispiel.de
EMAIL_FROM="News Bot <onboarding@resend.dev>"

# Optionaler Web-App Schutz (Weg B - Streamlit)
APP_PASSWORD=
STREAMLIT_APP_URL=https://news-aggregator-bot-....streamlit.app

# Optional: Automatischer GitHub-Sync für Quellen-Änderungen im Dashboard
GITHUB_TOKEN=
GITHUB_REPO=hschenke/news-aggregator-bot
GITHUB_BRANCH=main

# Optional: Turso Cloud-Datenbank (LibSQL / Cloud SQLite)
# Falls nicht angegeben, wird automatisch die lokale SQLite-DB (data/news_bot.db) genutzt
TURSO_URL=libsql://deine-datenbank.turso.io
TURSO_KEY=dein_turso_auth_token_hier
